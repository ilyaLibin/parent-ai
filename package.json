{
  "name": "parent-ai",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp group message tracker with AI summaries",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:listener": "npm run dev -w packages/listener",
    "dev:api": "npm run dev -w packages/api",
    "dev:telegram": "npm run dev -w packages/telegram",
    "dev:cron": "npm run dev -w packages/cron",
    "dev:dashboard": "npm run dev -w packages/dashboard",
    "dev:tts": "cd packages/tts && source venv/bin/activate && python app.py",
    "build": "npm run build --workspaces",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@types/better-sqlite3": "^7.6.13",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "pino": "^10.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
