# === Required ===

# Anthropic API key for Claude AI summaries and agent tasks
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp group IDs to monitor (comma-separated)
# Use the CLI to discover groups: npm run cli -- groups
TRACKED_GROUP_IDS=120363012345678901@g.us,120363098765432101@g.us

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
TELEGRAM_CHAT_ID=123456789

# === Optional ===

# SQLite database path (default: ./data/messages.db)
# DB_PATH=./data/messages.db

# API server port (default: 3033)
# API_PORT=3033

# API base URL — used by telegram bot, cron runner, and dashboard
# API_URL=http://localhost:3033

# TTS service URL and token (for voice messages via Telegram)
# TTS_URL=http://localhost:5050
# TTS_API_TOKEN=your-tts-token

# Weather location for renovation calendar (default: 32.79, 34.99)
# LOCATION_LAT=40.71
# LOCATION_LON=-74.01
