# Anthropic API key for Claude summaries
ANTHROPIC_API_KEY=sk-ant-...

# Track groups by ID (recommended - use `npx tsx src/cli.ts discover` to find IDs)
TRACKED_GROUP_IDS=120363012345678901@g.us,120363098765432101@g.us

# Or track by name substring (case-insensitive partial match)
# TRACKED_GROUPS=Family,Work Team

# Optional: Database path (defaults to ./data/messages.db)
# DB_PATH=./data/messages.db

# Optional: API server port (defaults to 3033)
# API_PORT=3033
